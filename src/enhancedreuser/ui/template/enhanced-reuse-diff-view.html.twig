{% extends "include/base.html.twig" %}
{% block styles %}
  {{ parent() }}
  <link rel="stylesheet" href="css/highlights.css"/>
{% endblock %}

{% block content %}
  <div id="leftrightalignment" name="leftrightalignment">
    <table border="0" style="padding:0px; height:100%; width:100%">
      <tr>
        <td style="padding:0px; position:relative; height: 100%; width:50%">
          <div class="centered" style='padding:2px;'>
            {{ pageMenu }}
            
            <a href="?mod=enhanced_reuse_analysis&upload={{ uploadId }}&item={{ item|default('') }}" class="btn btn-default btn-sm">{{ 'Back to Enhanced Reuse Analysis'|trans }}</a>
            
            <button class="legendHider btn btn-default btn-sm">
              {{ 'Hide Legend'| trans }}
            </button>
            <button class="legendShower btn btn-default btn-sm">
              {{ 'Show Legend'| trans }}
            </button>
          </div>
          
          <div class="boxnew" id="fileTextView" style="overflow:scroll;">
            <div style="font-family: monospace; font-size: 12px; margin: 0; white-space: pre; line-height: 1.2;">
{% for line in diffData %}{% if line.type == 'added' %}<div class="hi-added" style="background-color: #d4edda; color: #155724;">+ {{ line.content|e }}</div>
{% elseif line.type == 'deleted' %}<div class="hi-deleted" style="background-color: #f8d7da; color: #721c24;">- {{ line.content|e }}</div>
{% elseif line.type == 'modified' %}<div class="hi-changed" style="background-color: #fff3cd; color: #856404;">~ {{ line.content|e }}</div>
{% else %}<div style="color: #6c757d;">  {{ line.content|e }}</div>
{% endif %}
{% endfor %}
            </div>
          </div>
          
          <div id="legendBox" name="legendBox" style="background-color:white; padding:2px; border:1px outset #222222; width:150px; position:absolute; right:17px; bottom:17px; ">
            <u><b>{{ 'Legend:'| trans }}</b></u><br/>
            <span class="hi-added" style="background-color: #d4edda; color: #155724;">+ {{ 'Added lines'|trans }}</span><br/>
            <span class="hi-deleted" style="background-color: #f8d7da; color: #721c24;">- {{ 'Deleted lines'|trans }}</span><br/>
            <span class="hi-changed" style="background-color: #fff3cd; color: #856404;">~ {{ 'Modified lines'|trans }}</span><br/>
            <span style="color: #6c757d;">  {{ 'Unchanged lines'|trans }}</span>
          </div>
        </td>
        <td class="headerBox" style="min-width:100%;min-height:100%;">
          {% block rhs %}
            <div style="padding: 20px;">
              <!-- Two-Column Layout for Better Space Utilization -->
              <div style="display: table; width: 100%; table-layout: fixed;">
                <div style="display: table-row;">
                  
                  <!-- Left Column: Diff Statistics + File Details -->
                  <div style="display: table-cell; width: 50%; padding-right: 10px; vertical-align: top;">
                    
                    <!-- Diff Statistics Table -->
                    {% set totalLines = diffData|length %}
                    {% set addedLines = diffData|filter(line => line.type == 'added')|length %}
                    {% set deletedLines = diffData|filter(line => line.type == 'deleted')|length %}
                    {% set modifiedLines = diffData|filter(line => line.type == 'modified')|length %}
                    {% set unchangedLines = diffData|filter(line => line.type == 'unchanged')|length %}
                    
                    <table class="simpleTable" style="border: 1px solid #ddd; margin-bottom: 20px; width: 100%;">
                      <thead>
                        <tr style="background-color: #f5f5f5;">
                          <th colspan="3" style="text-align: center; padding: 8px; font-weight: bold;">{{ 'Diff Statistics'|trans }}</th>
                        </tr>
                        <tr style="background-color: #f5f5f5;">
                          <th style="padding: 8px;">{{ 'Metric'|trans }}</th>
                          <th style="text-align: center; padding: 8px;">{{ 'Count'|trans }}</th>
                          <th style="text-align: center; padding: 8px;">{{ 'Percentage'|trans }}</th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                          <td style="padding: 8px; font-weight: bold;">{{ 'Total Lines'|trans }}</td>
                          <td style="text-align: center; padding: 8px;">{{ totalLines }}</td>
                          <td style="text-align: center; padding: 8px;">100%</td>
                        </tr>
                        <tr>
                          <td style="padding: 8px; color: #28a745;">{{ 'Added'|trans }}</td>
                          <td style="text-align: center; padding: 8px;">{{ addedLines }}</td>
                          <td style="text-align: center; padding: 8px;">{{ totalLines > 0 ? ((addedLines / totalLines) * 100)|number_format(1) : 0 }}%</td>
                        </tr>
                        <tr>
                          <td style="padding: 8px; color: #dc3545;">{{ 'Deleted'|trans }}</td>
                          <td style="text-align: center; padding: 8px;">{{ deletedLines }}</td>
                          <td style="text-align: center; padding: 8px;">{{ totalLines > 0 ? ((deletedLines / totalLines) * 100)|number_format(1) : 0 }}%</td>
                        </tr>
                        <tr>
                          <td style="padding: 8px; color: #ffc107;">{{ 'Modified'|trans }}</td>
                          <td style="text-align: center; padding: 8px;">{{ modifiedLines }}</td>
                          <td style="text-align: center; padding: 8px;">{{ totalLines > 0 ? ((modifiedLines / totalLines) * 100)|number_format(1) : 0 }}%</td>
                        </tr>
                        <tr>
                          <td style="padding: 8px; color: #17a2b8;">{{ 'Unchanged'|trans }}</td>
                          <td style="text-align: center; padding: 8px;">{{ unchangedLines }}</td>
                          <td style="text-align: center; padding: 8px;">{{ totalLines > 0 ? ((unchangedLines / totalLines) * 100)|number_format(1) : 0 }}%</td>
                        </tr>
                      </tbody>
                    </table>

                    <!-- Unified File Information Table -->
                    <table class="simpleTable" style="border: 1px solid #ddd; width: 100%;">
                      <thead>
                        <tr style="background-color: #f5f5f5;">
                          <th colspan="3" style="text-align: center; padding: 8px; font-weight: bold;">{{ 'File Details Comparison'|trans }}</th>
                        </tr>
                        <tr style="background-color: #f5f5f5;">
                          <th style="padding: 8px;">{{ 'Property'|trans }}</th>
                          <th style="padding: 8px;">{{ 'Current File'|trans }}</th>
                          <th style="padding: 8px;">{{ 'Reused File'|trans }}</th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                          <td style="padding: 8px; font-weight: bold;">{{ 'File ID'|trans }}</td>
                          <td style="padding: 8px;">{{ currentFile.pfile_pk|e }}</td>
                          <td style="padding: 8px;">{{ reusedFile.pfile_pk|e }}</td>
                        </tr>
                        <tr>
                          <td style="padding: 8px; font-weight: bold;">{{ 'Size'|trans }}</td>
                          <td style="padding: 8px;">{{ currentFile.pfile_size|e }} bytes</td>
                          <td style="padding: 8px;">{{ reusedFile.pfile_size|e }} bytes</td>
                        </tr>
                        <tr>
                          <td style="padding: 8px; font-weight: bold;">{{ 'SHA1'|trans }}</td>
                          <td style="padding: 8px; font-family: monospace; font-size: 11px;">{{ currentFile.pfile_sha1|e }}</td>
                          <td style="padding: 8px; font-family: monospace; font-size: 11px;">{{ reusedFile.pfile_sha1|e }}</td>
                        </tr>
                        <tr>
                          <td style="padding: 8px; font-weight: bold;">{{ 'MD5'|trans }}</td>
                          <td style="padding: 8px; font-family: monospace; font-size: 11px;">{{ currentFile.pfile_md5|e }}</td>
                          <td style="padding: 8px; font-family: monospace; font-size: 11px;">{{ reusedFile.pfile_md5|e }}</td>
                        </tr>
                      </tbody>
                    </table>
                  </div>

                  <!-- Right Column: License Information + Clearing Decisions -->
                  <div style="display: table-cell; width: 50%; padding-left: 10px; vertical-align: top;">
                    
                    <!-- Unified License Information Table -->
                    <table class="simpleTable" style="border: 1px solid #ddd; margin-bottom: 20px; width: 100%;">
                      <thead>
                        <tr style="background-color: #f5f5f5;">
                          <th colspan="4" style="text-align: center; padding: 8px; font-weight: bold;">{{ 'License Information Comparison'|trans }}</th>
                        </tr>
                        <tr style="background-color: #f5f5f5;">
                          <th style="padding: 8px;">{{ 'License'|trans }}</th>
                          <th style="text-align: center; padding: 8px;">{{ 'Current'|trans }}</th>
                          <th style="text-align: center; padding: 8px;">{{ 'Reused'|trans }}</th>
                          <th style="padding: 8px;">{{ 'Status'|trans }}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {# Merge and compare licenses from both files #}
                        {% set allLicenses = {} %}
                        {% for license in currentLicenses %}
                          {% set allLicenses = allLicenses|merge({(license.rf_shortname): {
                            'current': license,
                            'reused': null,
                            'status': 'current-only'
                          }}) %}
                        {% endfor %}
                        {% for license in reusedLicenses %}
                          {% if allLicenses[license.rf_shortname] is defined %}
                            {% set allLicenses = allLicenses|merge({(license.rf_shortname): {
                              'current': allLicenses[license.rf_shortname].current,
                              'reused': license,
                              'status': 'both'
                            }}) %}
                          {% else %}
                            {% set allLicenses = allLicenses|merge({(license.rf_shortname): {
                              'current': null,
                              'reused': license,
                              'status': 'reused-only'
                            }}) %}
                          {% endif %}
                        {% endfor %}
                        
                        {% for licenseName, licenseData in allLicenses|sort %}
                          <tr>
                            <td style="padding: 8px; font-weight: bold; vertical-align: top;">
                              {{ licenseName|e }}
                              {% if licenseData.current and licenseData.current.rf_spdx_id %}
                                <br><small style="color: #666;">{{ licenseData.current.rf_spdx_id|e }}</small>
                              {% elseif licenseData.reused and licenseData.reused.rf_spdx_id %}
                                <br><small style="color: #666;">{{ licenseData.reused.rf_spdx_id|e }}</small>
                              {% endif %}
                            </td>
                            <td style="padding: 8px; vertical-align: top; font-size: 11px;">
                              {% if licenseData.current %}
                                <strong>{{ licenseData.current.agent_name|e }}</strong><br>
                                <small>{{ licenseData.current.rf_match_pct }}%</small><br>
                                <small style="color: #666;">
                                  {% if licenseData.current.fl_start_byte and licenseData.current.fl_end_byte %}
                                    {{ licenseData.current.fl_start_byte }}-{{ licenseData.current.fl_end_byte }}
                                  {% else %}
                                    N/A
                                  {% endif %}
                                </small>
                              {% else %}
                                <span style="color: #999;">-</span>
                              {% endif %}
                            </td>
                            <td style="padding: 8px; vertical-align: top; font-size: 11px;">
                              {% if licenseData.reused %}
                                <strong>{{ licenseData.reused.agent_name|e }}</strong><br>
                                <small>{{ licenseData.reused.rf_match_pct }}%</small><br>
                                <small style="color: #666;">
                                  {% if licenseData.reused.fl_start_byte and licenseData.reused.fl_end_byte %}
                                    {{ licenseData.reused.fl_start_byte }}-{{ licenseData.reused.fl_end_byte }}
                                  {% else %}
                                    N/A
                                  {% endif %}
                                </small>
                              {% else %}
                                <span style="color: #999;">-</span>
                              {% endif %}
                            </td>
                            <td style="padding: 8px; vertical-align: top;">
                              {% if licenseData.status == 'both' %}
                                <span style="color: #28a745; font-weight: bold;">✓ {{ 'Both'|trans }}</span>
                              {% elseif licenseData.status == 'current-only' %}
                                <span style="color: #dc3545; font-weight: bold;">+ {{ 'Added'|trans }}</span>
                              {% elseif licenseData.status == 'reused-only' %}
                                <span style="color: #ffc107; font-weight: bold;">- {{ 'Removed'|trans }}</span>
                              {% endif %}
                            </td>
                          </tr>
                        {% endfor %}
                      </tbody>
                    </table>

                    <!-- Unified Clearing Decisions Table -->
                    <table class="simpleTable" style="border: 1px solid #ddd; width: 100%;">
                      <thead>
                        <tr style="background-color: #f5f5f5;">
                          <th colspan="5" style="text-align: center; padding: 8px; font-weight: bold;">{{ 'Clearing Decisions Comparison'|trans }}</th>
                        </tr>
                        <tr style="background-color: #f5f5f5;">
                          <th style="padding: 8px;">{{ 'License'|trans }}</th>
                          <th style="text-align: center; padding: 8px;">{{ 'Current'|trans }}</th>
                          <th style="text-align: center; padding: 8px;">{{ 'Reused'|trans }}</th>
                          <th style="padding: 8px;">{{ 'Type'|trans }}</th>
                          <th style="padding: 8px;">{{ 'Status'|trans }}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {# Merge and compare clearing decisions from both files #}
                        {% set allDecisions = {} %}
                        {% for decision in currentClearingDecisions %}
                          {% set allDecisions = allDecisions|merge({(decision.rf_shortname): {
                            'current': decision,
                            'reused': null,
                            'status': 'current-only'
                          }}) %}
                        {% endfor %}
                        {% for decision in reusedClearingDecisions %}
                          {% if allDecisions[decision.rf_shortname] is defined %}
                            {% set allDecisions = allDecisions|merge({(decision.rf_shortname): {
                              'current': allDecisions[decision.rf_shortname].current,
                              'reused': decision,
                              'status': 'both'
                            }}) %}
                          {% else %}
                            {% set allDecisions = allDecisions|merge({(decision.rf_shortname): {
                              'current': null,
                              'reused': decision,
                              'status': 'reused-only'
                            }}) %}
                          {% endif %}
                        {% endfor %}
                        
                        {% for licenseName, decisionData in allDecisions|sort %}
                          <tr>
                            <td style="padding: 8px; font-weight: bold;">{{ licenseName|e }}</td>
                            <td style="padding: 8px; font-size: 11px;">
                              {% if decisionData.current %}
                                <small>{{ decisionData.current.date_added|date("Y-m-d") }}</small><br>
                                <small style="color: #666;">{{ decisionData.current.comment|e|default('-') }}</small>
                              {% else %}
                                <span style="color: #999;">-</span>
                              {% endif %}
                            </td>
                            <td style="padding: 8px; font-size: 11px;">
                              {% if decisionData.reused %}
                                <small>{{ decisionData.reused.date_added|date("Y-m-d") }}</small><br>
                                <small style="color: #666;">{{ decisionData.reused.comment|e|default('-') }}</small>
                              {% else %}
                                <span style="color: #999;">-</span>
                              {% endif %}
                            </td>
                            <td style="padding: 8px;">
                              {% if decisionData.current %}
                                {% if decisionData.current.decision_type == 5 %}
                                  <span style="color: #28a745;">{{ 'Identified'|trans }}</span>
                                {% elseif decisionData.current.decision_type == 4 %}
                                  <span style="color: #17a2b8;">{{ 'Confirmed'|trans }}</span>
                                {% else %}
                                  <span style="color: #6c757d;">{{ 'Other'|trans }}</span>
                                {% endif %}
                              {% elseif decisionData.reused %}
                                {% if decisionData.reused.decision_type == 5 %}
                                  <span style="color: #28a745;">{{ 'Identified'|trans }}</span>
                                {% elseif decisionData.reused.decision_type == 4 %}
                                  <span style="color: #17a2b8;">{{ 'Confirmed'|trans }}</span>
                                {% else %}
                                  <span style="color: #6c757d;">{{ 'Other'|trans }}</span>
                                {% endif %}
                              {% endif %}
                            </td>
                            <td style="padding: 8px;">
                              {% if decisionData.status == 'both' %}
                                <span style="color: #28a745; font-weight: bold;">✓ {{ 'Both'|trans }}</span>
                              {% elseif decisionData.status == 'current-only' %}
                                <span style="color: #dc3545; font-weight: bold;">+ {{ 'Added'|trans }}</span>
                              {% elseif decisionData.status == 'reused-only' %}
                                <span style="color: #ffc107; font-weight: bold;">- {{ 'Removed'|trans }}</span>
                              {% endif %}
                            </td>
                          </tr>
                        {% endfor %}
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          {% endblock %}
        </td>
      </tr>
    </table>
  </div>
{% endblock %}

{% block foot %}
  {{ parent() }}
  <script src="scripts/legend.js" type="text/javascript"></script>
  <script src="scripts/tools.js" type="text/javascript"></script>
{% endblock %}
