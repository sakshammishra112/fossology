<script>
// Filter functionality for comprehensive diff tree
document.addEventListener('DOMContentLoaded', function() {
  const fileNameSearch = document.getElementById('fileNameSearch');
  const classificationFilter = document.getElementById('classificationFilter');
  const licenseUploadFilter = document.getElementById('licenseUploadFilter');
  const licenseReuseFilter = document.getElementById('licenseReuseFilter');
  const statusFilter = document.getElementById('statusFilter');
  const changedLinesFilter = document.getElementById('changedLinesFilter');
  const typeFilter = document.getElementById('typeFilter');
  const riskFilter = document.getElementById('riskFilter');
  const diffTreeBody = document.getElementById('diff-tree-body');
  
  // Populate license filters from data
  function populateLicenseFilters() {
    const rows = diffTreeBody.querySelectorAll('tr');
    const uploadLicenses = new Set();
    const reuseLicenses = new Set();
    
    rows.forEach(row => {
      const uploadLicense = row.dataset.uploadLicense;
      const reuseLicense = row.dataset.reuseLicense;
      
      if (uploadLicense && uploadLicense !== '') uploadLicenses.add(uploadLicense);
      if (reuseLicense && reuseLicense !== '') reuseLicenses.add(reuseLicense);
    });
    
    // Populate upload license filter
    licenseUploadFilter.innerHTML = '<option value="">{{ 'All'|trans }}</option>';
    Array.from(uploadLicenses).sort().forEach(license => {
      licenseUploadFilter.innerHTML += `<option value="${license}">${license}</option>`;
    });
    
    // Populate reuse license filter
    licenseReuseFilter.innerHTML = '<option value="">{{ 'All'|trans }}</option>';
    Array.from(reuseLicenses).sort().forEach(license => {
      licenseReuseFilter.innerHTML += `<option value="${license}">${license}</option>`;
    });
  }
  
  // Filter function
  function applyFilters() {
    const rows = diffTreeBody.querySelectorAll('tr');
    const fileNameValue = fileNameSearch.value.toLowerCase();
    const classificationValue = classificationFilter.value;
    const licenseUploadValue = licenseUploadFilter.value;
    const licenseReuseValue = licenseReuseFilter.value;
    const statusValue = statusFilter.value;
    const changedLinesValue = changedLinesFilter.value;
    const typeValue = typeFilter.value;
    const riskValue = riskFilter.value;
    
    rows.forEach(row => {
      const fileName = row.dataset.fileName.toLowerCase();
      const classification = row.dataset.classification;
      const uploadLicense = row.dataset.uploadLicense;
      const reuseLicense = row.dataset.reuseLicense;
      const status = row.dataset.status;
      const changedLines = row.dataset.changedLines;
      const type = row.dataset.type;
      const risk = row.dataset.risk;
      
      let showRow = true;
      
      // File name filter
      if (fileNameValue && !fileName.includes(fileNameValue)) {
        showRow = false;
      }
      
      // Classification filter
      if (classificationValue && classification !== classificationValue) {
        showRow = false;
      }
      
      // License upload filter
      if (licenseUploadValue && uploadLicense !== licenseUploadValue) {
        showRow = false;
      }
      
      // License reuse filter
      if (licenseReuseValue && reuseLicense !== licenseReuseValue) {
        showRow = false;
      }
      
      // Status filter
      if (statusValue && status !== statusValue) {
        showRow = false;
      }
      
      // Changed lines filter
      if (changedLinesValue) {
        if (changedLinesValue === 'has-changes' && (!changedLines || changedLines === '' || changedLines === '0')) {
          showRow = false;
        } else if (changedLinesValue === 'no-changes' && changedLines && changedLines !== '' && changedLines !== '0') {
          showRow = false;
        }
      }
      
      // Type filter
      if (typeValue && type !== typeValue) {
        showRow = false;
      }
      
      // Risk filter
      if (riskValue && risk !== riskValue) {
        showRow = false;
      }
      
      row.style.display = showRow ? '' : 'none';
    });
  }
  
  // Event listeners
  if (fileNameSearch) fileNameSearch.addEventListener('input', applyFilters);
  if (classificationFilter) classificationFilter.addEventListener('change', applyFilters);
  if (licenseUploadFilter) licenseUploadFilter.addEventListener('change', applyFilters);
  if (licenseReuseFilter) licenseReuseFilter.addEventListener('change', applyFilters);
  if (statusFilter) statusFilter.addEventListener('change', applyFilters);
  if (changedLinesFilter) changedLinesFilter.addEventListener('change', applyFilters);
  if (typeFilter) typeFilter.addEventListener('change', applyFilters);
  if (riskFilter) riskFilter.addEventListener('change', applyFilters);
  
  // Initialize license filters
  populateLicenseFilters();
});
</script>

<script>
// Handle tab switching for original tabs (first row)
document.addEventListener('DOMContentLoaded', function() {
  const tabs1 = document.querySelectorAll('#enhanced-reuse-tabs-1 a[data-toggle="tab"]');
  const panes1 = document.querySelectorAll('#enhanced-reuse-tab-content .tab-pane');
  
  tabs1.forEach(tab => {
    tab.addEventListener('click', function(e) {
      e.preventDefault();
      
      // Remove active class from all tabs and panes
      tabs1.forEach(t => t.classList.remove('active'));
      panes1.forEach(p => p.classList.remove('show', 'active'));
      
      // Add active class to clicked tab and corresponding pane
      this.classList.add('active');
      const targetId = this.getAttribute('href').substring(1);
      const targetPane = document.getElementById(targetId);
      if (targetPane) {
        targetPane.classList.add('show', 'active');
      }
    });
  });
  
  });
</script>

